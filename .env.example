# Copy to .env and fill in. Never commit the real .env.

# Neon Postgres — use the POOLED connection string (host contains "-pooler").
# Neon Console → Project → Connection Details → Pooled connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Separate portfolio-tracker DB, accessed READ-ONLY (see
# server/db/portfolio-client.ts — no write path exists in code for this one).
PORTFOLIO_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Shared secret guarding the admin POST routes (sent as the x-admin-key header
# from the "İçerik Ekle" page). Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_KEY=change-me

# API port. Locally 3000; Railway sets PORT automatically.
PORT=3000

# ── Sanal Portföy girişi ────────────────────────────────────────────────────
# Portföyü DEĞİŞTİREN her route bir oturum ister. Parola asla koda yazılmaz;
# aşağıdaki değerleri kendi terminalinizde üretin:
#   node scripts/hash-password.mjs
PORTFOLIO_AUTH_USER=kullanici-adiniz
PORTFOLIO_AUTH_HASH=scrypt$16384$8$1$...$...
SESSION_SECRET=en-az-16-karakter-rastgele-deger

# ── Fiyat kaynakları ────────────────────────────────────────────────────────
# BIST + ABD hisseleri: GOOGLEFINANCE satırlarını dönen Apps Script web app'i.
# Yeni bir sembol eklendiğinde POST ile otomatik kaydedilir.
SHEETS_PRICE_URL=https://script.google.com/macros/s/.../exec
# TEFAS fonları fintables.com'dan kazınıyor; anahtar yoksa doğrudan denenir
# (çoğunlukla engellenir). Eski PortfoyTakip uygulamasının anahtarı kullanılır.
SCRAPER_API_KEY=
